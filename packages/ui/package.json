{
	"name": "@saksham/ui",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"peerDependencies": {
		"astro": "^7.3.5"
	},
	"devDependencies": {
		"astro": "7.4.1"
	},
	"exports": {
		".": "./src/index.ts",
		"./components/*": "./src/components/*",
		"./styles/*": "./src/styles/*",
		"./seo": "./src/seo.ts",
		"./error-response": "./src/error-response.ts",
		"./components/FormattedDate.astro": "./src/components/FormattedDate.astro",
		"./styles/tokens.css": "./src/styles/tokens.css"
	},
	"scripts": {
		"build": "tsc --ignoreConfig --declaration --emitDeclarationOnly --outDir dist --target ES2022 --module ESNext --moduleResolution Bundler --strict src/index.ts",
		"lint": "oxlint . && eslint '**/*.astro' --no-warn-ignored",
		"lint:fix": "oxlint . --fix && eslint '**/*.astro' --no-warn-ignored --fix",
		"format": "oxfmt .",
		"format:check": "oxfmt --check .",
		"typecheck": "tsc --noEmit -p ../../tsconfig.json",
		"check": "tsc --noEmit -p ../../tsconfig.json"
	}
}
