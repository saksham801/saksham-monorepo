---
const statusUrl = "https://saksham.openstatus.dev/";
---
<a
  href={statusUrl}
  target="_blank"
  rel="noopener noreferrer"
  class="inline-flex items-center gap-2 text-inherit no-underline transition-colors hover:text-ui-accent focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-ui-accent motion-reduce:transition-none"
>
  <span class="size-1.5 rounded-full border border-current" aria-hidden="true"></span>
  System status
  <span class="sr-only">(opens external status page)</span>
</a>
