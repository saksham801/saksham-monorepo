---
interface Props {
	href?: string;
	name?: string;
	subtitle?: string;
	ariaLabel?: string;
}

const {
	href = "/",
	name = "SAKSHAM",
	subtitle = "ENGINEERING NOTES",
	ariaLabel = `${name} home`,
} = Astro.props;
---

<a
	class="inline-flex items-center gap-[0.6875rem] text-ui-fg no-underline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-ui-accent"
	href={href}
	aria-label={ariaLabel}
>
	<span
		class="inline-flex size-[2.125rem] items-center justify-center border border-ui-accent font-ui-sans text-[1.0625rem] font-bold tracking-[-0.12em] text-ui-accent"
	>
		S<span class="text-[#dce7eb]">D</span>
	</span>
	<span class="font-ui-sans text-[0.6875rem] leading-[1.2] font-semibold tracking-[0.06em] text-[#dce7eb]">
		{name}<br /><small class="font-ui-mono text-[0.5rem] font-normal tracking-[0.08em] text-[#667780]">{subtitle}</small>
	</span>
</a>
