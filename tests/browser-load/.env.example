# Production defaults are provided when TARGET=production; local examples:
TARGET=local
PORTFOLIO_URL=http://localhost:4321
DOCS_URL=http://localhost:4322
BLOGS_URL=http://localhost:4323

# Test safety and capacity
USERS=3
DURATION=60
MAX_USERS=50
MAX_DURATION=600
MAX_REQUESTS=100000
TARGET_ALLOWLIST=localhost,127.0.0.1
SEED=123
INITIAL_USERS=1
RAMP_UP_SECONDS=30
HOLD_SECONDS=60
RAMP_DOWN_SECONDS=10

# Only for an authorized production load run; requires >3 users to opt in.
ALLOW_PRODUCTION_LOAD_TEST=false
PERF_P95_MS=3000
ERROR_RATE_PERCENT=1
FAILED_REQUEST_RATE_PERCENT=1
