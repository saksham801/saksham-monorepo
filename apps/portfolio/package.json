{
	"name": "portfolio",
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "astro dev",
		"build": "bun run scripts/generate-sitemap.ts && astro build",
		"preview": "bun run build && astro preview",
		"lint": "oxlint . && eslint '**/*.astro' --no-warn-ignored",
		"lint:fix": "oxlint . --fix && eslint '**/*.astro' --no-warn-ignored --fix",
		"format": "oxfmt .",
		"format:check": "oxfmt --check .",
		"typecheck": "astro check",
		"typecheck:tsrs": "tsrs --noEmit -p tsconfig.json",
		"check": "astro check",
		"astro": "astro",
		"generate-types": "cf workers types",
		"deploy": "wrangler deploy --config dist/server/wrangler.json",
		"cf-typegen": "cf workers types"
	},
	"dependencies": {
		"@astrojs/cloudflare": "14.4.1",
		"@astrojs/sitemap": "^3.7.4",
		"@saksham/ui": "workspace:*",
		"astro": "7.4.1"
	},
	"devDependencies": {
		"@astrojs/check": "0.9.11",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26.6.5",
		"cf": "^1.0.0-beta.20",
		"tailwindcss": "^4.3.3",
		"wrangler": "^4.152.0"
	},
	"engines": {
		"bun": ">=1.4.0"
	},
	"allowScripts": {
		"esbuild": true
	}
}
