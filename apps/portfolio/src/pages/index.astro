        </header>
        <div id="mobile-menu" class="mobile-menu hidden">
            <a href="#about">/ about</a>
            <a href="#work">/ work</a>
            <a href="#experience">/ experience</a>
            <a href="/health">/ health</a>
            <a href="#contact">/ contact</a>
        </div>

        <main id="top" class="mx-auto max-w-7xl px-5 lg:px-10">
            <section class="hero reveal">
                <div class="hero-copy reveal">
                    <p class="kicker">
                        <span class="prompt">&gt;_</span> HELLO, WORLD. I'M
                        SAKSHAM.
                    </p>
                    <h1>
                        ENGINEERING
                        <br />
                        <em>IDEAS</em> INTO
                        <br />
                        REALITY<span class="cursor">_</span>
                    </h1>
