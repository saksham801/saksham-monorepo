                </div>
                <div class="terminal-card reveal reveal-delay">
                    <div class="terminal-head">
                        <span class="dots">
                            <i></i>
                            <i></i>
                            <i></i>
                        </span>
                        <span>saksham@localhost:~</span>
                        <span>⌁</span>
                    </div>
                    <div class="terminal-body">
                        <p>
                            <span class="green">const</span> developer = &#123;
                        </p>
                        <p class="indent">
                            <span class="blue">name:</span>{" "}
                            <span class="yellow">"Saksham Dubey"</span>,
                        </p>
                        <p class="indent">
                            <span class="blue">role:</span>{" "}
                            <span class="yellow">"Full Stack Engineer"</span>,
                        </p>
                        <p class="indent">
                            <span class="blue">experience:</span>{" "}
                            <span class="purple">"4+ years"</span>,
                        </p>
                        <p class="indent">
                            <span class="blue">location:</span>{" "}
                            <span class="yellow">"New Delhi, IN"</span>,
                        </p>
                        <p class="indent">
                            <span class="blue">focus:</span> [
                            <span class="yellow">"systems"</span>,{" "}
                            <span class="yellow">"interfaces"</span>],
                        </p>
                        <p>&#125;;</p>
                        <p class="terminal-output">
                            <span class="green">✓</span> ready to ship good
                            software<span class="blink">▌</span>
                        </p>
                    </div>
                    <div class="terminal-foot">
                        <span>UTF-8</span>
                        <span>main*</span>
                        <span>Ln 08, Col 32</span>
                    </div>
                </div>
                <div class="hero-aside">
                    <span>SCROLL TO EXPLORE</span>
