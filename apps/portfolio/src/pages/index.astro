---
import Layout from "../layouts/Layout.astro";

export const prerender = true;

const skills = [
    "TypeScript",
    "React.js",
    "Next.js",
    "Angular",
    "Node.js",
    "NestJS",
    "Python",
    "PostgreSQL",
    "MongoDB",
    "Microservices",
    "REST APIs",
    "Git",
];
const projects = [
    {
        id: "01",
        name: "Solid Starters",
        label: "LOW-CODE PLATFORM",
        text: "A low-code platform turning complex business requirements into production-ready applications.",
        stack: "Angular · Next.js · NestJS",
        accent: "lime",
    },
    {
        id: "02",
        name: "Radix",
        label: "E-COMMERCE SYSTEM",
        text: "A scalable commerce experience built around modular services and a content-first workflow.",
        stack: "Next.js · Microservices · CMS",
        accent: "blue",
    },
    {
        id: "03",
        name: "Bond Cancellation",
        label: "WORKFLOW AUTOMATION",
        text: "Connected workflows that streamline import-export logistics from request to completion.",
        stack: "Angular · NestJS · Workflows",
        accent: "orange",
    },
    {
        id: "04",
        name: "Sapphire",
        label: "CRM PLATFORM",
        text: "Real-time customer intelligence and analytics for enterprise teams.",
        stack: "AngularJS · PostgreSQL · Analytics",
        accent: "purple",
    },
    {
        id: "05",
        name: "Mpro",
        label: "INSURANCE PLATFORM",
        text: "Resilient operations software built around high-performance microservices.",
        stack: "React.js · Node.js · Microservices",
        accent: "blue",
    },
];
const experience = [
    {
        year: "NOW",
        role: "Senior Full Stack Developer",
        company: "Monocept · Max Life Insurance",
        text: "Building Solid, a proprietary low-code platform with Angular, Next.js and NestJS.",
    },
    {
        year: "2021",
        role: "Full Stack Developer",
        company: "Logic Loop",
        text: "Led two development teams on Mpro and migrated critical insurance functionality to Node.js microservices.",
    },
    {
        year: "2020",
        role: "Frontend Developer",
        company: "Independent",
        text: "Built 6+ complete React applications with Node.js, MongoDB and responsive UI systems.",
    },
];
---

<Layout>
