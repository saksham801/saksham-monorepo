        </div>
        <header class="header mx-auto max-w-7xl px-5 py-5 lg:px-10">
            <a href="#top" class="brand">
                <span class="brand-mark">
                    S<span>D</span>
                </span>
                <span class="brand-copy">
                    SAKSHAM
                    <br />
                    <small>FULL STACK ENGINEER</small>
                </span>
            </a>
            <nav class="nav">
                <a href="#about">/ about</a>
                <a href="#work">/ work</a>
