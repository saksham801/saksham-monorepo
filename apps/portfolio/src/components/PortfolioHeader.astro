---
import Brand from "@saksham/ui/components/Brand.astro";

interface Props {
	active?: "home" | "terms";
}

const { active = "home" } = Astro.props;
const sectionHref = (section: string) => active === "home" ? `#${section}` : `/#${section}`;
---

<a class="skip-link" href="#main-content">Skip to main content</a>
<div class="portfolio-topline" aria-label="Site information">
	<span>SAKSHAM.DUBEY // PORTFOLIO</span>
	<span><i aria-hidden="true"></i> FULL STACK ENGINEER <b>·</b> NEW DELHI, IN</span>
</div>
<header class="portfolio-header">
	<Brand href={active === "home" ? "#top" : "/"} subtitle="FULL STACK ENGINEER" ariaLabel="Saksham Dubey portfolio home" />
	<button class="menu-toggle" type="button" aria-controls="portfolio-navigation" aria-expanded="false">
		<span class="menu-toggle-label">[ MENU ]</span>
	</button>
	<nav class="portfolio-nav" id="portfolio-navigation" aria-label="Primary">
		<a href={sectionHref("about")} data-section="about">/ about</a>
		<a href={sectionHref("work")} data-section="work">/ work</a>
		<a href={sectionHref("experience")} data-section="experience">/ experience</a>
		<details class="site-menu">
			<summary>/ explore <span aria-hidden="true">⌄</span></summary>
			<div class="site-menu-panel">
				<strong>ELSEWHERE</strong>
				<a href="https://blogs.sakshampy.in/" target="_blank" rel="noopener noreferrer">Engineering blog <span>↗</span></a>
				<a href="https://docs.sakshampy.in/" target="_blank" rel="noopener noreferrer">Engineering docs <span>↗</span></a>
				<a href="/health">System status</a>
				<a href="/terms/" aria-current={active === "terms" ? "page" : undefined}>Terms</a>
				<a href="mailto:hello@sakshampy.in">Get in touch <span>↗</span></a>
			</div>
		</details>
	</nav>
	<a class="contact-button" href="mailto:hello@sakshampy.in">LET’S TALK <span aria-hidden="true">↗</span></a>
</header>

<script>
	const header = document.querySelector<HTMLElement>(".portfolio-header");
	const toggle = header?.querySelector<HTMLButtonElement>(".menu-toggle");
	const navigation = header?.querySelector<HTMLElement>("#portfolio-navigation");
	const toggleLabel = toggle?.querySelector<HTMLElement>(".menu-toggle-label");
	header?.classList.add("has-js");
	const setOpen = (open: boolean) => {
		navigation?.classList.toggle("is-open", open);
		toggle?.setAttribute("aria-expanded", String(open));
		if (toggleLabel) toggleLabel.textContent = open ? "[ CLOSE ]" : "[ MENU ]";
	};

	toggle?.addEventListener("click", () => setOpen(toggle.getAttribute("aria-expanded") !== "true"));
	navigation?.querySelectorAll("a").forEach((link) => link.addEventListener("click", () => setOpen(false)));
	document.addEventListener("keydown", (event) => {
		if (event.key === "Escape" && toggle?.getAttribute("aria-expanded") === "true") {
			setOpen(false);
			toggle.focus();
		}
	});
	document.addEventListener("click", (event) => {
		if (event.target instanceof Node && !header?.contains(event.target)) setOpen(false);
	});
	window.matchMedia("(min-width: 801px)").addEventListener("change", () => setOpen(false));

	const sectionLinks = navigation?.querySelectorAll<HTMLAnchorElement>("[data-section]");
	const sections = [...(document.querySelectorAll<HTMLElement>("main section[id]"))];
	if ("IntersectionObserver" in window) {
		const observer = new IntersectionObserver((entries) => {
			for (const entry of entries) {
				if (!entry.isIntersecting) continue;
				sectionLinks?.forEach((link) => {
					const current = link.dataset.section === entry.target.id;
					link.classList.toggle("is-current", current);
					if (current) link.setAttribute("aria-current", "location");
					else link.removeAttribute("aria-current");
				});
			}
		}, { rootMargin: "-25% 0px -65%" });
		sections.forEach((section) => observer.observe(section));
	}
</script>

<style>
	.skip-link {
		background: #a8ff60;
		color: #090b0d;
		font: 600 0.7rem "DM Mono", monospace;
		left: 1rem;
		padding: 0.75rem 1rem;
		position: fixed;
		top: 0.75rem;
		transform: translateY(-160%);
		transition: transform 160ms ease;
		z-index: 100;
	}
	.skip-link:focus { transform: translateY(0); }
	.portfolio-topline {
		align-items: center;
		border-bottom: 1px solid #202a30;
		color: #718189;
		display: flex;
		font: 0.55rem "DM Mono", monospace;
		justify-content: space-between;
		letter-spacing: 0.1em;
		min-height: 1.9rem;
		padding-inline: max(5vw, calc((100vw - 80rem) / 2));
	}
	.portfolio-topline span:last-child { align-items: center; display: flex; gap: 0.55rem; }
	.portfolio-topline i { background: #a8ff60; border-radius: 50%; height: 0.35rem; width: 0.35rem; }
	.portfolio-topline b { color: #3b4b53; font-weight: 400; }
	.portfolio-header {
		align-items: center;
		backdrop-filter: blur(18px);
		background: rgb(9 11 13 / 0.88);
		border-bottom: 1px solid #202a30;
		display: grid;
		gap: clamp(0.75rem, 1.5vw, 1.5rem);
		grid-template-columns: auto minmax(0, 1fr) auto;
		margin-inline: auto;
		max-width: 80rem;
		min-height: 5rem;
		padding: 0.8rem clamp(1.25rem, 5vw, 3rem);
		position: sticky;
		top: 0;
		z-index: 40;
	}
	.portfolio-nav { align-items: center; display: flex; gap: clamp(0.8rem, 1.5vw, 1.5rem); justify-content: flex-end; }
	.portfolio-nav > a,
	.site-menu summary {
		color: #89989f;
		cursor: pointer;
		font: 0.61rem "DM Mono", monospace;
		letter-spacing: 0.09em;
		list-style: none;
		padding-block: 0.55rem;
		position: relative;
		text-decoration: none;
		text-transform: uppercase;
		transition: color 180ms ease;
		white-space: nowrap;
	}
	.site-menu summary::-webkit-details-marker { display: none; }
	.portfolio-nav > a::after,
	.site-menu summary::after {
		background: currentColor;
		bottom: 0.2rem;
		content: "";
		height: 1px;
		inset-inline: 0;
		position: absolute;
		transform: scaleX(0);
		transform-origin: left;
		transition: transform 180ms ease;
	}
	.portfolio-nav > a:hover,
	.portfolio-nav > a:focus-visible,
	.portfolio-nav > a.is-current,
	.site-menu summary:hover,
	.site-menu[open] summary { color: #a8ff60; }
	.portfolio-nav > a:hover::after,
	.portfolio-nav > a:focus-visible::after,
	.portfolio-nav > a.is-current::after,
	.site-menu summary:hover::after,
	.site-menu[open] summary::after { transform: scaleX(1); }
	.site-menu { position: relative; }
	.site-menu-panel {
		background: #0d1519;
		border: 1px solid #33464f;
		box-shadow: 0 1rem 2.5rem rgb(0 0 0 / 0.38);
		display: grid;
		gap: 0.2rem;
		min-width: 13rem;
		padding: 0.8rem;
		position: absolute;
		right: 0;
		top: calc(100% + 0.35rem);
		z-index: 2;
	}
	.site-menu-panel strong { color: #63757d; font: 0.5rem "DM Mono", monospace; letter-spacing: 0.13em; padding: 0.35rem 0.55rem; }
	.site-menu-panel a {
		align-items: center;
		color: #b6c3c8;
		display: flex;
		font: 0.68rem "DM Mono", monospace;
		justify-content: space-between;
		padding: 0.55rem;
		text-decoration: none;
		transition: background 160ms ease, color 160ms ease;
	}
	.site-menu-panel a:hover,
	.site-menu-panel a[aria-current="page"] { background: #142127; color: #a8ff60; }
	.site-menu-panel a span { color: #a8ff60; }
	.contact-button {
		border: 1px solid #3b4b53;
		color: #dce7eb;
		font: 0.6rem "DM Mono", monospace;
		letter-spacing: 0.09em;
		padding: 0.7rem 0.85rem;
		text-decoration: none;
		transition: border-color 180ms ease, color 180ms ease, background 180ms ease;
		white-space: nowrap;
	}
	.contact-button span { color: #a8ff60; }
	.contact-button:hover { background: #101a20; border-color: #a8ff60; color: #a8ff60; }
	.menu-toggle { display: none; }
	@media (max-width: 950px) and (min-width: 801px) {
		.portfolio-header { grid-template-columns: auto minmax(0, 1fr) auto; }
		.portfolio-nav { gap: 0.7rem; }
		.portfolio-nav > a, .site-menu summary { font-size: 0.54rem; }
	}
	@media (max-width: 800px) {
		.portfolio-topline { min-height: 1.65rem; }
		.portfolio-topline span:last-child { display: none; }
		.portfolio-header { grid-template-columns: minmax(0, 1fr) auto; min-height: 4.5rem; }
		.portfolio-header.has-js .menu-toggle {
			align-items: center;
			background: transparent;
			border: 1px solid #33464f;
			color: #a8ff60;
			cursor: pointer;
			display: inline-flex;
			font: 0.6rem "DM Mono", monospace;
			justify-content: center;
			letter-spacing: 0.08em;
			line-height: 1;
			min-height: 1.9rem;
			min-width: 4.8rem;
			padding: 0 0.55rem;
		}
		.menu-toggle:hover, .menu-toggle[aria-expanded="true"] { border-color: #a8ff60; color: #e8edf0; }
		.portfolio-nav,
		.portfolio-nav.is-open {
			align-items: stretch;
			background: #090b0d;
			border: 1px solid #33464f;
			box-shadow: 0 1rem 2rem rgb(0 0 0 / 0.35);
			flex-direction: column;
			gap: 0;
			grid-column: 1 / -1;
			left: clamp(1.25rem, 5vw, 3rem);
			padding: 0.5rem;
			position: absolute;
			right: clamp(1.25rem, 5vw, 3rem);
			top: calc(100% + 0.25rem);
		}
		.portfolio-header.has-js .portfolio-nav { display: none; }
		.portfolio-header.has-js .portfolio-nav.is-open { display: flex; }
		.portfolio-nav > a, .site-menu summary { display: block; padding: 0.8rem; }
		.portfolio-nav > a { border-bottom: 1px solid #202a30; }
		.site-menu { padding-block: 0.25rem; }
		.site-menu-panel { border: 0; border-top: 1px solid #26343b; box-shadow: none; min-width: 0; position: static; }
		.contact-button { display: none; }
	}
	@media (prefers-reduced-motion: reduce) {
		.skip-link, .portfolio-nav > a, .site-menu summary, .portfolio-nav > a::after, .site-menu summary::after, .contact-button { transition: none; }
	}
</style>
