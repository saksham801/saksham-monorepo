---
const isSplash = Astro.locals.starlightRoute.entry.data.template === 'splash';
const headings = Astro.locals.starlightRoute.headings ?? [];
---

<div class="page sl-flex">
	<header class="header"><slot name="header" /></header>
	<div class:list={["main-frame", { "has-docs-sidebar": !isSplash }]}>
		{!isSplash && <aside class="docs-sidebar" aria-label="Documentation navigation">
			<p class="docs-sidebar-label">DOCUMENTATION</p>
			<a href="/guides/about/">About these notes</a>
			<a href="/reference/toolbox/">Engineering toolbox</a>
			<p class="docs-sidebar-label">LANGUAGES</p>
			<strong>Rust</strong>
			<a href="/languages/rust/">Overview</a>
			<a href="/languages/rust/ownership/">Ownership</a>
			<a href="/languages/rust/tooling/">Tooling</a>
			<strong>C++</strong>
			<a href="/languages/cpp/">Overview</a>
			<a href="/languages/cpp/memory/">Memory</a>
			<a href="/languages/cpp/tooling/">Tooling</a>
			<strong>Python</strong>
			<a href="/languages/python/">Overview</a>
			<a href="/languages/python/packaging/">Packaging</a>
			<a href="/languages/python/tooling/">Tooling</a>
		</aside>}
		<div class="docs-content"><slot /></div>
		{!isSplash && headings.length > 0 && <aside class="docs-toc" aria-label="On this page">
			<p class="docs-sidebar-label">ON THIS PAGE</p>
			{headings.filter((heading) => heading.depth <= 3).map((heading) => (
				<a href={`#${heading.slug}`}>{heading.text}</a>
			))}
		</aside>}
	</div>
</div>

<style>
	@layer starlight.core {
		.page {
			flex-direction: column;
			min-height: 100vh;
		}

		.header {
			position: fixed;
			inset-block-start: 0;
			inset-inline-start: 0;
			width: 100%;
			z-index: var(--sl-z-index-navbar);
			height: var(--sl-nav-height);
			padding: var(--sl-nav-pad-y) var(--sl-nav-pad-x);
			background: var(--sl-color-bg-nav);
			border-bottom: 1px solid var(--sl-color-hairline-shade);
		}

		.main-frame {
			padding-top: var(--sl-nav-height);
		}

		.has-docs-sidebar {
			display: grid;
			grid-template-columns: 13rem minmax(0, 1fr) 11rem;
			gap: 2rem;
			max-width: 90rem;
			margin-inline: auto;
			padding-inline: 1.25rem;
			width: 100%;
		}

		.docs-sidebar {
			align-self: start;
			border-inline-end: 1px solid #202a30;
			display: grid;
			gap: 0.35rem;
			padding: 2rem 1.25rem 3rem 0;
			position: sticky;
			top: var(--sl-nav-height);
		}

		.docs-sidebar-label {
			color: #63757d;
			font-size: 0.58rem;
			letter-spacing: 0.12em;
			margin: 0.75rem 0 0.25rem;
		}

		.docs-sidebar a,
		.docs-sidebar strong {
			color: #91a2aa;
			font-size: 0.72rem;
			font-weight: 400;
			line-height: 1.5;
			padding: 0.2rem 0.45rem;
			text-decoration: none;
		}

		.docs-sidebar strong {
			color: #dce7eb;
			font-family: 'Manrope', sans-serif;
			font-weight: 700;
			margin-top: 0.45rem;
		}

		.docs-sidebar a:hover {
			background: #101a20;
			color: #a8ff60;
		}

		.docs-content {
			min-width: 0;
		}

		.docs-toc {
			align-self: start;
			display: grid;
			gap: 0.5rem;
			padding: 2rem 0 3rem 1rem;
			position: sticky;
			top: var(--sl-nav-height);
		}

		.docs-toc a {
			color: #63757d;
			font-size: 0.64rem;
			line-height: 1.5;
			text-decoration: none;
		}

		.docs-toc a:hover {
			color: #a8ff60;
		}

		@media (max-width: 800px) {
			.has-docs-sidebar {
				display: block;
				padding-inline: 0;
			}
			.docs-sidebar {
				display: none;
			}
			.docs-toc {
				display: none;
			}
		}
	}
</style>
