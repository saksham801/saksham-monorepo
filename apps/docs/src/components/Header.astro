---
import Search from '@astrojs/starlight/components/Search.astro';
import Brand from '@saksham/ui/components/Brand.astro';

const navLinks = [
	{ href: '/docs/', label: '/ docs home' },
	{ href: '/docs/guides/about/', label: '/ guides' },
	{ href: '/docs/reference/toolbox/', label: '/ reference' },
	{ href: '/docs/terms/', label: '/ terms' },
	{ href: 'https://sakshampy.in/', label: '/ portfolio', external: true },
];
---

<div class="topline">
	<span>SAKSHAM.DUBEY // DOCS_V1.0</span>
	<span class="topline-right"><i></i> SYSTEMS ONLINE</span>
</div>
<div class="header">
	<Brand href="/docs/" name="SAKSHAM" subtitle="ENGINEERING DOCS" ariaLabel="Saksham's Docs home" />
	<Search class="docs-search" />
	<nav class="docs-nav print:hidden" aria-label="Primary">
		{
			navLinks.map((link) =>
				link.external ? (
					<a href={link.href} target="_blank" rel="noopener noreferrer">
						{link.label}
					</a>
				) : (
					<a href={link.href}>{link.label}</a>
				),
			)
		}
		<details class="docs-menu">
			<summary>/ docs</summary>
			<div class="docs-menu-panel">
				<div class="docs-menu-group">
					<strong>GUIDES</strong>
					<a href="/docs/guides/about/">About these notes</a>
				</div>
				<div class="docs-menu-group">
					<strong>REFERENCE</strong>
					<a href="/docs/reference/toolbox/">Engineering toolbox</a>
				</div>
				<div class="docs-menu-group">
					<strong>LANGUAGES / RUST</strong>
					<a href="/docs/languages/rust/">Overview</a>
					<a href="/docs/languages/rust/ownership/">Ownership</a>
					<a href="/docs/languages/rust/tooling/">Tooling</a>
				</div>
				<div class="docs-menu-group">
					<strong>LANGUAGES / C++</strong>
					<a href="/docs/languages/cpp/">Overview</a>
					<a href="/docs/languages/cpp/memory/">Memory</a>
					<a href="/docs/languages/cpp/tooling/">Tooling</a>
				</div>
				<div class="docs-menu-group">
					<strong>LANGUAGES / PYTHON</strong>
					<a href="/docs/languages/python/">Overview</a>
					<a href="/docs/languages/python/packaging/">Packaging</a>
					<a href="/docs/languages/python/tooling/">Tooling</a>
				</div>
			</div>
		</details>
	</nav>
	<a href="mailto:hello@sakshampy.in" class="hire-button">WRITE ME <span>↗</span></a>
</div>

<style>
	@layer starlight.core {
		.header {
			align-items: center;
			display: grid;
			gap: clamp(0.75rem, 1.5vw, 1.5rem);
			grid-template-columns: auto auto minmax(0, 1fr) auto;
			min-width: 0;
		}
		.docs-search { justify-self: start; }
		.docs-nav { align-items: center; display: flex; gap: clamp(0.75rem, 1.25vw, 1.25rem); justify-content: flex-end; min-width: 0; }
		:global(site-search button[data-open-modal]) {
			background: transparent;
			border: 1px solid #3b4b53;
			border-radius: 0;
			color: #91a2aa;
			font-family: 'DM Mono', monospace;
			font-size: 0.625rem;
			min-height: 2.15rem;
			padding-inline: 0.65rem;
			width: auto;
		}
		:global(site-search button[data-open-modal]:hover) {
			border-color: #a8ff60;
			color: #a8ff60;
		}

		.docs-nav a {
			color: #89989f;
			font-size: 0.625rem;
			letter-spacing: 0.1em;
			text-transform: uppercase;
			text-decoration: none;
			transition: color 0.2s ease;
			white-space: nowrap;
		}

		.docs-nav a:hover {
			color: #a8ff60;
		}

		.docs-menu { position: relative; }
		.docs-menu summary { color: #89989f; cursor: pointer; font-size: 0.625rem; letter-spacing: 0.1em; list-style: none; text-transform: uppercase; white-space: nowrap; }
		.docs-menu summary::-webkit-details-marker { display: none; }
		.docs-menu summary:hover,
		.docs-menu[open] summary { color: #a8ff60; }
		.docs-menu-panel { background: #101a20; border: 1px solid #33464f; display: grid; gap: 0.85rem; min-width: 16rem; padding: 1rem; position: absolute; right: 0; top: 1.6rem; z-index: 2; }
		.docs-menu-group { display: grid; gap: 0.35rem; }
		.docs-menu-group + .docs-menu-group { border-top: 1px solid #26343b; padding-top: 0.75rem; }
		.docs-menu-group strong { color: #63757d; font-size: 0.5rem; font-weight: 400; letter-spacing: 0.1em; }
		.docs-menu-panel a { color: #a8ff60; font-size: 0.58rem; padding-inline-start: 0.5rem; }
		.docs-menu-panel a:hover { color: #e8edf0; }

		.hire-button {
			border: 1px solid #3b4b53;
			color: #dce7eb;
			font-size: 0.625rem;
			letter-spacing: 0.1em;
			padding: 0.55rem 0.85rem;
			text-decoration: none;
			text-transform: uppercase;
			transition: border-color 0.2s ease, color 0.2s ease;
			white-space: nowrap;
		}

		.hire-button span {
			color: #a8ff60;
		}

		.hire-button:hover {
			border-color: #a8ff60;
			color: #a8ff60;
		}

		.topline { align-items: center; border-bottom: 1px solid #202a30; color: #617078; display: flex; font: 0.52rem 'DM Mono', monospace; justify-content: space-between; letter-spacing: 0.1em; min-height: 1.875rem; }
		.topline-right { align-items: center; display: flex; gap: 0.7rem; }
		.topline i { background: #a8ff60; border-radius: 50%; display: inline-block; height: 0.35rem; width: 0.35rem; }
		@media (max-width: 950px) {
			.header { grid-template-columns: auto auto minmax(0, 1fr); }
			.docs-nav { grid-column: 3; }
			.docs-nav > a { display: none; }
			.hire-button { display: none; }
		}
		@media (max-width: 800px) {
			.topline { display: none; }
			.header { grid-template-columns: max-content auto max-content; justify-content: space-between; }
			.docs-search { justify-self: end; }
			.docs-nav { grid-column: auto; }
			.ui-brand-copy { font-size: 0.62rem; }
		}
	}
</style>
