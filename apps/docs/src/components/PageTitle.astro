---
const id = 'top';
const { entry } = Astro.locals.starlightRoute;
const isSplash = entry.data.template === 'splash';
---

{
	!isSplash && (
		<h1 id={id}>{Astro.locals.starlightRoute.entry.data.title}</h1>
	)
}
{
	isSplash && <span id={id} class="sr-only">{Astro.locals.starlightRoute.entry.data.title}</span>
}

<style>
	@layer starlight.core {
		h1 {
			margin-top: 1rem;
			font-size: var(--sl-text-h1);
			line-height: var(--sl-line-height-headings);
			font-weight: 600;
			color: var(--sl-color-white);
		}
	}
</style>
