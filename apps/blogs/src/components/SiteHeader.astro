---
import { PORTFOLIO_URL, SITE_EMAIL } from "../consts";
import Brand from "@saksham/ui/components/Brand.astro";

interface Props {
	active?: "home" | "blog" | "about" | "terms";
}

const { active = "home" } = Astro.props;

const links = [
	{ href: "/", label: "/ home", key: "home" },
	{ href: "/blog", label: "/ blog", key: "blog" },
	{ href: "/about", label: "/ about", key: "about" },
	{ href: "/terms", label: "/ terms", key: "terms" },
	{ href: PORTFOLIO_URL, label: "/ portfolio", key: "portfolio", external: true },
] as const;
---

<div
	class="pointer-events-none fixed top-[calc(var(--pointer-y,40vh)-230px)] left-[calc(var(--pointer-x,50vw)-230px)] z-0 size-[460px] bg-[radial-gradient(circle,rgba(168,255,96,0.12)_0,rgba(101,201,255,0.04)_22%,transparent_60%)]"
	aria-hidden="true"
></div>
<div
	class="relative z-ui-content flex justify-between border-b border-[#202a30] px-[5vw] py-[9px] font-ui-mono text-[9px] tracking-[0.1em] text-[#617078]"
>
	<span>SAKSHAM.DUBEY // BLOG_V1.0</span>
	<span class="flex items-center gap-3 max-[50rem]:[&>b]:hidden">
		<i class="inline-block size-1.5 rounded-full bg-ui-accent"></i> SYSTEMS ONLINE <b
			id="site-clock"
			class="font-normal text-[#8a989e] max-[50rem]:hidden">--:--:-- IST</b
		>
	</span>
</div>
<header
	class="sticky top-0 z-ui-header mx-auto flex max-w-7xl items-center justify-between border-b border-[#202a30] bg-[rgba(9,11,13,0.78)] px-5 py-5 backdrop-blur-[16px] lg:px-10"
>
	<Brand subtitle="ENGINEERING BLOG" />
	<nav class="flex gap-[29px] max-[50rem]:hidden" aria-label="Primary">
		{
			links.map((link) => (
				<a
					href={link.href}
					class="font-ui-mono text-ui-sm tracking-[0.1em] text-[#89989f] uppercase no-underline transition-colors hover:text-ui-accent focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-ui-accent aria-[current=page]:text-ui-accent"
					aria-current={active === link.key ? "page" : undefined}
					target={"external" in link && link.external ? "_blank" : undefined}
					rel={"external" in link && link.external ? "noreferrer" : undefined}
				>
					{link.label}
				</a>
			))
		}
	</nav>
	<a
		href={`mailto:${SITE_EMAIL}`}
		class="border border-[#3b4b53] px-3.5 py-2.5 font-ui-mono text-ui-sm tracking-[0.1em] text-[#dce7eb] uppercase no-underline transition-colors hover:border-ui-accent hover:text-ui-accent focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-ui-accent max-[50rem]:hidden"
	>
		WRITE ME <span>↗</span>
	</a>
	<button
		id="menu-button"
		class="hidden cursor-pointer border-0 bg-transparent font-ui-mono text-ui-sm tracking-[0.1em] text-[#89989f] uppercase hover:text-ui-accent focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-ui-accent max-[50rem]:block"
		type="button"
		aria-controls="mobile-menu"
		aria-expanded="false"
	>
		<span id="menu-label">[ MENU ]</span>
	</button>
</header>
<nav
	id="mobile-menu"
	class="relative z-ui-content hidden flex-col gap-5 border-b border-[#33464f] bg-ui-raised p-5"
	aria-label="Mobile primary"
>
	{
		links.map((link) => (
			<a
				href={link.href}
				class="font-ui-mono text-ui-sm text-ui-accent no-underline hover:text-ui-fg focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-ui-accent"
				target={"external" in link && link.external ? "_blank" : undefined}
				rel={"external" in link && link.external ? "noreferrer" : undefined}
			>
				{link.label}
			</a>
		))
	}
</nav>

<script>
	const button = document.querySelector("#menu-button");
	const menu = document.querySelector("#mobile-menu");
	const label = document.querySelector("#menu-label");
	const setMenuOpen = (isOpen: boolean) => {
		menu?.classList.toggle("hidden", !isOpen);
		menu?.classList.toggle("flex", isOpen);
		button?.setAttribute("aria-expanded", String(isOpen));
		if (label) label.textContent = isOpen ? "[ CLOSE ]" : "[ MENU ]";
	};
	button?.addEventListener("click", () => {
		setMenuOpen(menu?.classList.contains("hidden") ?? false);
	});
	menu?.querySelectorAll("a").forEach((link) =>
		link.addEventListener("click", () => setMenuOpen(false)),
	);
	document.addEventListener("keydown", (event) => {
		if (event.key === "Escape" && menu && !menu.classList.contains("hidden")) {
			setMenuOpen(false);
			if (button instanceof HTMLButtonElement) button.focus();
		}
	});

	const glow = document.querySelector(".pointer-glow");
	window.addEventListener("pointermove", (event) => {
		if (
			glow instanceof HTMLElement &&
			window.matchMedia("(pointer: fine)").matches &&
			!window.matchMedia("(prefers-reduced-motion: reduce)").matches
		) {
			glow.style.setProperty("--pointer-x", `${event.clientX}px`);
			glow.style.setProperty("--pointer-y", `${event.clientY}px`);
		}
	});

	const clock = document.querySelector("#site-clock");
	const tick = () => {
		if (!clock) return;
		clock.textContent = new Date().toLocaleTimeString("en-IN", {
			hour12: false,
			timeZone: "Asia/Kolkata",
		}) + " IST";
	};
	tick();
	setInterval(tick, 1000);
</script>
