---
import "../styles/global.css";
	import SeoHead from "@saksham/ui/components/SeoHead.astro";
import {
	SITE_AUTHOR,
	SITE_DESCRIPTION,
	SITE_EMAIL,
	SITE_TITLE,
	SITE_URL,
} from "../consts";

interface Props {
	title?: string;
	description?: string;
	canonicalPath?: string;
	ogType?: "website" | "article";
	publishedTime?: Date;
	modifiedTime?: Date;
	tags?: string[];
	robots?: string;
	jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
	title = SITE_TITLE,
	description = SITE_DESCRIPTION,
	canonicalPath = Astro.url.pathname,
	ogType = "website",
	publishedTime,
	modifiedTime,
	tags = [],
	robots,
	jsonLd,
} = Astro.props;

const pageTitle = title === SITE_TITLE ? title : `${title} — Saksham Dubey`;

const personSchema = {
	"@type": "Person",
	"@id": `${SITE_URL}/#person`,
	name: SITE_AUTHOR,
	url: `${SITE_URL}/`,
	email: `mailto:${SITE_EMAIL}`,
};
const websiteSchema = {
	"@type": "WebSite",
	"@id": `${SITE_URL}/blogs/#website`,
	name: SITE_TITLE,
	url: `${SITE_URL}/blogs/`,
	description: SITE_DESCRIPTION,
	author: { "@id": `${SITE_URL}/#person` },
	inLanguage: "en",
};
const pageNodes = (jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [{
	"@type": "WebPage",
	"@id": `${SITE_URL}${canonicalPath}#webpage`,
	name: pageTitle,
	url: `${SITE_URL}${canonicalPath}`,
	description,
	isPartOf: { "@id": `${SITE_URL}/blogs/#website` },
	inLanguage: "en",
}]).map((node) =>
	Object.fromEntries(Object.entries(node).filter(([key]) => key !== "@context")),
);
const pageTypes = pageNodes.map((node) => node["@type"]);
const structuredData = {
	"@context": "https://schema.org",
	"@graph": [
		...(!pageTypes.includes("Person") ? [personSchema] : []),
		...(!pageTypes.includes("WebSite") ? [websiteSchema] : []),
		...pageNodes,
	],
};
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="theme-color" content="#090b0d" />
		<SeoHead
			title={pageTitle}
			description={description}
			siteName="Saksham Dubey Engineering Blog"
			contentType={ogType}
			robots={robots}
			canonicalPath={robots?.includes("noindex") ? undefined : canonicalPath}
			publishedTime={publishedTime}
			modifiedTime={modifiedTime}
			jsonLd={robots?.includes("noindex") ? undefined : structuredData}
		/>
		{tags.length > 0 && <meta name="keywords" content={tags.join(", ")} />}
		<link
			rel="alternate"
			type="text/markdown"
			href={`${import.meta.env.BASE_URL}/llms.txt`}
			title="LLM-friendly blog profile"
		/>
		<link
			rel="alternate"
			type="application/rss+xml"
			title={SITE_TITLE}
			href={new URL("/blogs/rss.xml", SITE_URL).href}
		/>
		{tags.map((tag) => <meta property="article:tag" content={tag} />)}
		<link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}/favicon.svg`} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link
			rel="preconnect"
			href="https://fonts.gstatic.com"
			crossorigin="anonymous"
		/>
		<link
			href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Manrope:wght@400;500;600;700;800&display=swap"
			rel="stylesheet"
		/>
		<title>{pageTitle}</title>

	</head>
	<body
		class="bg-[#090b0d] text-[#e8edf0] antialiased selection:bg-[#a8ff60] selection:text-[#090b0d]"
	>
		<slot />
	</body>
</html>
