---
import { getCollection, render } from "astro:content";
import ErrorPage from "@saksham/ui/components/ErrorPage.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import BlogPost from "../../layouts/BlogPost.astro";
import Layout from "../../layouts/Layout.astro";

export const prerender = false;

const slug = Astro.params.slug;
const post = slug
	? (await getCollection("blog")).find((entry) => entry.id === slug)
	: undefined;
const rendered = post ? await render(post) : undefined;
const Content = rendered?.Content;

if (!post) Astro.response.status = 404;
---
{
	post && Content ? (
		<BlogPost {...post.data} slug={post.id}>
			<Content />
		</BlogPost>
	) : (
		<Layout title="Page not found" robots="noindex, follow">
			<div class="site-shell min-h-screen" id="top">
				<SiteHeader active="blog" />
				<ErrorPage section="blogs" />
			</div>
		</Layout>
	)
}
