---
import ErrorPage from "@saksham/ui/components/ErrorPage.astro";
import SiteHeader from "../components/SiteHeader.astro";
import Layout from "../layouts/Layout.astro";

export const prerender = false;

const url = new URL(Astro.request.url);
const hostname = url.hostname.toLowerCase();
const isLocalHost = hostname === "localhost" || hostname === "127.0.0.1";

if (hostname !== "sakshampy.in" && !isLocalHost) {
	url.protocol = "https:";
	url.hostname = "sakshampy.in";
	if (url.pathname === "/blog" || url.pathname === "/blogs") {
		url.pathname = "/blogs/";
	} else if (url.pathname.startsWith("/blog/")) {
		url.pathname = `/blogs${url.pathname.slice("/blog".length)}`;
	} else if (!url.pathname.startsWith("/blogs/")) {
		url.pathname = `/blogs${url.pathname}`;
	}
	return Astro.redirect(url.href, 301);
}

Astro.response.status = 404;
---
<Layout title="Page not found" robots="noindex, follow">
	<div class="site-shell min-h-screen" id="top">
		<SiteHeader active="blog" />
		<ErrorPage section="blogs" />
	</div>
</Layout>
