---
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import Layout from "../layouts/Layout.astro";
import { PORTFOLIO_URL, SITE_AUTHOR, SITE_EMAIL } from "../consts";

export const prerender = true;
---

<Layout
	title="About"
	description="About Saksham Dubey and this engineering blog covering C++, Rust, and Python."
	canonicalPath="/about/"
	jsonLd={{
		"@context": "https://schema.org",
		"@type": "AboutPage",
		name: "About",
		url: "https://blogs.sakshampy.in/about/",
		mainEntity: {
			"@type": "Person",
			name: SITE_AUTHOR,
			jobTitle: "Full Stack Engineer",
			email: `mailto:${SITE_EMAIL}`,
			url: PORTFOLIO_URL,
			knowsAbout: ["C++", "Rust", "Python", "TypeScript", "Web Engineering"],
		},
	}}
>
	<div class="site-shell min-h-screen" id="top">
		<SiteHeader active="about" />
		<main class="mx-auto max-w-7xl px-5 lg:px-10">
			<section class="page-hero">
				<p class="kicker">
					<span class="prompt">&gt;_</span> ABOUT / AUTHOR
				</p>
				<h1>
					Built for
					<br />
					<em>clarity.</em>
				</h1>
				<p class="intro">
					I'm Saksham Dubey — a full stack engineer writing practical notes on
					systems languages and modern application development.
				</p>
			</section>
			<section class="content-grid">
				<div class="section-label">
					<span>01</span>
					<span>INTENT</span>
				</div>
				<div>
					<p class="lead">
						This blog exists to explain hard topics with short examples,
						honest trade-offs, and code you can reuse.
					</p>
					<p class="muted">
						Expect posts on C++ memory and ownership patterns, Rust's safety
						model, and Python tooling for real products. The same visual system
						as <a href={PORTFOLIO_URL}>sakshampy.in</a> keeps the experience consistent
						across portfolio and writing.
					</p>
					<div class="stats">
						<div>
							<strong>03</strong>
							<small>CORE TOPICS</small>
						</div>
						<div>
							<strong>SEO</strong>
							<small>+ LLMS.TXT</small>
						</div>
						<div>
							<strong>RSS</strong>
							<small>SYNDICATION</small>
						</div>
					</div>
					<a class="mail" href={`mailto:${SITE_EMAIL}`}>
						{SITE_EMAIL} <span>↗</span>
					</a>
				</div>
			</section>
		</main>
		<SiteFooter />
	</div>
</Layout>

<style>
	.site-shell {
		background-color: #090b0d;
		background-image:
			linear-gradient(rgba(73, 91, 102, 0.08) 1px, transparent 1px),
			linear-gradient(90deg, rgba(73, 91, 102, 0.08) 1px, transparent 1px);
		background-size: 64px 64px;
		isolation: isolate;
		position: relative;
	}
	main {
		position: relative;
		z-index: 1;
		padding-bottom: 100px;
	}
	.page-hero {
		padding: 90px 0 50px;
	}
	.kicker {
		color: #82949c;
		font-size: 10px;
		letter-spacing: 0.13em;
		margin: 0 0 24px;
	}
	.prompt,
	em {
		color: #a8ff60;
		font-style: normal;
	}
	h1 {
		font:
			800 clamp(3.2rem, 7vw, 6.5rem)/0.9 "Manrope",
			sans-serif;
		letter-spacing: -0.08em;
		margin: 0;
	}
	.intro {
		color: #91a2aa;
		font-size: 13px;
		line-height: 1.9;
		margin: 28px 0 0;
		max-width: 520px;
	}
	.content-grid {
		border-top: 1px solid #26343b;
		display: grid;
		gap: 7vw;
		grid-template-columns: 170px 1fr;
		padding-top: 70px;
	}
	.section-label {
		color: #63757d;
		display: flex;
		flex-direction: column;
		font-size: 9px;
		gap: 8px;
		letter-spacing: 0.12em;
	}
	.section-label span:first-child {
		color: #a8ff60;
	}
	.lead {
		font:
			500 clamp(1.8rem, 3.5vw, 3rem)/1.15 "Manrope",
			sans-serif;
		letter-spacing: -0.05em;
		margin: 0;
		max-width: 640px;
	}
	.muted {
		color: #91a2aa;
		font-size: 12px;
		line-height: 2;
		margin: 28px 0 0;
		max-width: 560px;
	}
	.muted a {
		color: #a8ff60;
		border-bottom: 1px solid rgba(168, 255, 96, 0.35);
	}
	.stats {
		border-top: 1px solid #2b3b42;
		display: flex;
		gap: clamp(25px, 6vw, 80px);
		margin-top: 48px;
		padding-top: 18px;
	}
	.stats div {
		display: flex;
		flex-direction: column;
		gap: 10px;
	}
	.stats strong {
		font:
			500 34px "Manrope",
			sans-serif;
		letter-spacing: -0.06em;
	}
	.stats small {
		color: #687b83;
		font-size: 8px;
		letter-spacing: 0.07em;
	}
	.mail {
		border-bottom: 1px solid #a8ff60;
		color: #dce7eb;
		display: inline-flex;
		font-size: 12px;
		gap: 16px;
		margin-top: 42px;
		padding-bottom: 10px;
	}
	.mail span {
		color: #a8ff60;
	}
	@media (max-width: 800px) {
		.content-grid {
			display: block;
		}
		.section-label {
			flex-direction: row;
			gap: 12px;
			margin-bottom: 36px;
		}
	}
</style>
