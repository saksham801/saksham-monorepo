---
import { getCollection } from "astro:content";
import FormattedDate from "@saksham/ui/components/FormattedDate.astro";
import SiteFooter from "@saksham/ui/components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import Layout from "../layouts/Layout.astro";
import { SITE_DESCRIPTION, SITE_TITLE, SITE_URL } from "../consts";

const posts = (await getCollection("blog")).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const topicLabel: Record<string, string> = {
	cpp: "C++",
	rust: "RUST",
	python: "PYTHON",
	cloudflare: "CLOUDFLARE WORKERS",
	ai: "AI & DECISIONS",
	general: "GENERAL",
};

const filterTopics = [...new Set(posts.map((post) => post.data.topic))].sort();

const accentFor: Record<string, string> = {
	cpp: "lime",
	rust: "orange",
	python: "blue",
	cloudflare: "purple",
	ai: "pink",
	general: "purple",
};
---

<Layout
	title="Blog"
	description={`All posts from ${SITE_TITLE}. ${SITE_DESCRIPTION}`}
	canonicalPath="/blogs/"
	jsonLd={{
		"@context": "https://schema.org",
		"@type": "CollectionPage",
		name: "Blog",
		url: `${SITE_URL}/blogs/`,
		description: SITE_DESCRIPTION,
		hasPart: posts.map((post) => ({
			"@type": "BlogPosting",
			headline: post.data.title,
			url: `${SITE_URL}/blogs/${post.id}/`,
			datePublished: post.data.pubDate.toISOString(),
		})),
	}}
>
	<div class="site-shell min-h-screen" id="top">
		<SiteHeader active="blog" />
		<main id="main-content" class="mx-auto max-w-7xl px-5 lg:px-10">
			<section class="page-hero reveal is-visible">
				<p class="kicker">
					<span class="prompt">&gt;_</span> ARCHIVE / ALL POSTS
				</p>
				<h1>
					Engineering
					<br />
					<em>notes.</em>
				</h1>
				<p class="intro">
					{posts.length} posts across C++, Rust, Python, Cloudflare Workers, and AI — optimized for
					humans, crawlers, and LLMs.
				</p>
			</section>
			<section class="post-tools" aria-label="Find articles">
				<label class="article-search">
					<span>SEARCH ARTICLES</span>
					<input id="article-search" type="search" placeholder="Title, topic, or keyword" autocomplete="off" />
				</label>
				<div class="topic-filters" aria-label="Filter articles by topic">
					<button type="button" data-filter="all" aria-pressed="true">ALL <span>{posts.length}</span></button>
					{filterTopics.map((topic) => (
						<button type="button" data-filter={topic} aria-pressed="false">
							{topicLabel[topic] ?? topic} <span>{posts.filter((post) => post.data.topic === topic).length}</span>
						</button>
					))}
				</div>
				<p class="filter-count" id="filter-count" role="status" aria-live="polite">{posts.length} articles</p>
			</section>
			<section class="grid" aria-label="Engineering articles">
				{
					posts.map((post, index) => (
						<a
							href={`/blogs/${post.id}/`}
							class={`ui-card card project-${accentFor[post.data.topic] ?? "lime"} ${index === 0 ? "featured" : ""}`}
							data-topic={post.data.topic}
							data-search={[post.data.title, post.data.description, post.data.topic, ...post.data.tags].join(" ").toLowerCase()}
						>
							<div class="card-top">
								<span>
									{String(index + 1).padStart(2, "0")} /{" "}
									{String(posts.length).padStart(2, "0")}
								</span>
								<span class="status">
									<i /> PUBLISHED
								</span>
							</div>
							<div class="card-visual">
								<span class="bracket">{"{"}</span>
								<span class="code">{post.data.topic}</span>
								<span class="bracket">{"}"}</span>
							</div>
							<div class="card-info">
								<p>{topicLabel[post.data.topic] ?? post.data.topic}</p>
								<h2>{post.data.title}</h2>
								<span class="arrow">↗</span>
								<p class="text">{post.data.description}</p>
								<p class="meta">
									<FormattedDate date={post.data.pubDate} />
									{post.data.tags.length > 0 && (
										<> · {post.data.tags.slice(0, 3).join(" · ")}</>
									)}
								</p>
							</div>
						</a>
					))
				}
			</section>
		<p class="filter-empty" id="filter-empty" hidden>No articles match that search. Try another keyword or topic.</p>
		</main>
		<SiteFooter
			links={[
				{ href: "/blogs/terms/", label: "TERMS" },
				{ href: "/blogs/llms.txt", label: "LLMS.TXT" },
				{ href: "https://sakshampy.in", label: "PORTFOLIO ↗", external: true },
			]}
		/>
	</div>
</Layout>

<script>
	const shell = document.querySelector<HTMLElement>(".site-shell");
	const search = document.querySelector<HTMLInputElement>("#article-search");
	const cards = [...document.querySelectorAll<HTMLAnchorElement>(".card[data-topic]")];
	const filters = [...document.querySelectorAll<HTMLButtonElement>("[data-filter]")];
	const count = document.querySelector<HTMLElement>("#filter-count");
	const empty = document.querySelector<HTMLElement>("#filter-empty");
	let activeTopic = "all";

	function updateArticles() {
		const query = search?.value.trim().toLocaleLowerCase() ?? "";
		let visible = 0;
		for (const card of cards) {
			const matchesTopic = activeTopic === "all" || card.dataset.topic === activeTopic;
			const matchesQuery = !query || (card.dataset.search ?? "").includes(query);
			const show = matchesTopic && matchesQuery;
			card.hidden = !show;
			if (show) visible += 1;
		}
		if (count) count.textContent = `${visible} ${visible === 1 ? "article" : "articles"}`;
		if (empty) empty.hidden = visible > 0;
	}

	shell?.classList.add("has-filter");
	search?.addEventListener("input", updateArticles);
	filters.forEach((button) => button.addEventListener("click", () => {
		activeTopic = button.dataset.filter || "all";
		filters.forEach((item) => item.setAttribute("aria-pressed", String(item === button)));
		updateArticles();
	}));
</script>

<style>
	.site-shell {
		background-color: #090b0d;
		background-image:
			linear-gradient(rgba(73, 91, 102, 0.08) 1px, transparent 1px),
			linear-gradient(90deg, rgba(73, 91, 102, 0.08) 1px, transparent 1px);
		background-size: 64px 64px;
		isolation: isolate;
		position: relative;
	}
	main {
		position: relative;
		z-index: 1;
		padding-bottom: 90px;
	}
	.page-hero {
		padding: 90px 0 55px;
	}
	.kicker {
		color: #82949c;
		font-size: 10px;
		letter-spacing: 0.13em;
		margin: 0 0 24px;
	}
	.prompt,
	em {
		color: #a8ff60;
		font-style: normal;
	}
	h1 {
		font:
			800 clamp(3.2rem, 7vw, 6.5rem)/0.9 "Manrope",
			sans-serif;
		letter-spacing: -0.08em;
		margin: 0;
	}
	.intro {
		color: #91a2aa;
		font-size: 12px;
		line-height: 1.9;
		margin: 24px 0 0;
		max-width: 480px;
	}
	.post-tools { display: none; }
	.site-shell.has-filter .post-tools {
		align-items: end;
		border-block: 1px solid #26343b;
		display: grid;
		gap: 1rem 1.5rem;
		grid-template-columns: minmax(13rem, 0.8fr) minmax(0, 1.6fr) auto;
		margin-bottom: 1.25rem;
		padding-block: 1rem;
	}
	.article-search { display: grid; gap: 0.45rem; }
	.article-search > span { color: #63757d; font-size: 0.52rem; letter-spacing: 0.12em; }
	.article-search input {
		background: #0d1519;
		border: 1px solid #33464f;
		border-radius: 0;
		color: #e8edf0;
		font: 0.68rem "DM Mono", monospace;
		min-height: 2.6rem;
		min-width: 0;
		padding: 0.65rem 0.75rem;
		width: 100%;
	}
	.article-search input::placeholder { color: #63757d; }
	.article-search input:focus-visible { border-color: #a8ff60; outline: 2px solid #a8ff60; outline-offset: 2px; }
	.topic-filters { display: flex; flex-wrap: wrap; gap: 0.4rem; }
	.topic-filters button {
		background: transparent;
		border: 1px solid #26343b;
		color: #91a2aa;
		cursor: pointer;
		font: 0.54rem "DM Mono", monospace;
		letter-spacing: 0.04em;
		min-height: 2.35rem;
		padding: 0.45rem 0.6rem;
		transition: border-color 160ms ease, color 160ms ease, background 160ms ease;
	}
	.topic-filters button span { color: #63757d; margin-inline-start: 0.25rem; }
	.topic-filters button:hover, .topic-filters button[aria-pressed="true"] { background: #101a20; border-color: #a8ff60; color: #a8ff60; }
	.filter-count { color: #63757d; font-size: 0.58rem; margin: 0; white-space: nowrap; }
	.filter-empty { border: 1px dashed #33464f; color: #91a2aa; margin: 1rem 0; padding: 1.5rem; }
	.card[hidden] { display: none; }
	.grid {
		display: grid;
		gap: 12px;
		grid-template-columns: repeat(12, minmax(0, 1fr));
	}
	.card {
		display: flex;
		flex-direction: column;
		grid-column: span 6;
		min-height: 390px;
		overflow: hidden;
		position: relative;
	}
	.card.featured {
		grid-column: 1 / -1;
	}
	.card:hover {
		transform: translateY(-5px);
	}
	.card-top {
		color: #6c7e85;
		display: flex;
		font-size: 9px;
		justify-content: space-between;
		letter-spacing: 0.1em;
		padding: 17px;
	}
	.status {
		color: #70837c;
		font-size: 8px;
	}
	.status i {
		background: #a8ff60;
		border-radius: 50%;
		display: inline-block;
		height: 6px;
		margin-right: 6px;
		width: 6px;
	}
	.card-visual {
		align-items: center;
		background:
			repeating-linear-gradient(
				0deg,
				transparent,
				transparent 29px,
				rgba(98, 130, 143, 0.1) 30px
			),
			repeating-linear-gradient(
				90deg,
				transparent,
				transparent 29px,
				rgba(98, 130, 143, 0.1) 30px
			);
		display: flex;
		flex: 0 0 120px;
		gap: 10px;
		justify-content: center;
	}
	.code {
		color: #8298a0;
		font:
			700 18px "DM Mono",
			monospace;
		letter-spacing: -0.08em;
	}
	.bracket {
		color: #a8ff60;
		font:
			90px/1 "Manrope",
			sans-serif;
		opacity: 0.45;
	}
	.project-blue .code {
		color: #65c9ff;
	}
	.project-orange .code {
		color: #ff9c68;
	}
	.project-purple .code {
		color: #d29aff;
	}
	.project-pink .code {
		color: #ff7eb9;
	}
	.card-info {
		display: flex;
		flex: 1;
		flex-direction: column;
		padding: 24px 20px;
		position: relative;
	}
	.card-info > p:first-child {
		color: #a8ff60;
		font-size: 8px;
		letter-spacing: 0.1em;
		margin: 0 0 10px;
	}
	.card-info h2 {
		font:
			600 24px "Manrope",
			sans-serif;
		letter-spacing: -0.05em;
		margin: 0;
		padding-right: 30px;
	}
	.arrow {
		color: #a8ff60;
		font-size: 22px;
		position: absolute;
		right: 20px;
		top: 22px;
	}
	.text {
		color: #82949c;
		font-size: 11px;
		line-height: 1.7;
		margin: 15px 0 14px;
	}
	.meta {
		color: #5c7078;
		font-size: 9px;
		letter-spacing: 0.06em;
		margin-top: auto;
		text-transform: uppercase;
	}
	@media (max-width: 900px) {
		.site-shell.has-filter .post-tools { grid-template-columns: 1fr; }
		.filter-count { justify-self: end; }
	}
	@media (max-width: 800px) {
		.grid {
			grid-template-columns: 1fr;
		}
		.card,
		.card.featured {
			grid-column: 1;
		}
	}
</style>
