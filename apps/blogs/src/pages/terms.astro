---
import TermsContent from "@saksham/ui/components/TermsContent.astro";
import SiteFooter from "@saksham/ui/components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import Layout from "../layouts/Layout.astro";
import { SITE_AUTHOR, SITE_EMAIL, SITE_URL } from "../consts";

const updated = "September 19, 2026";
---

<Layout
	title="Terms and Conditions"
	description="Terms and conditions for the Saksham portfolio, engineering blog, and documentation sites."
	canonicalPath="/blogs/terms/"
	jsonLd={{
		"@context": "https://schema.org",
		"@type": "WebPage",
		name: "Terms and Conditions",
		url: `${SITE_URL}/blogs/terms/`,
		dateModified: "2026-09-19",
		isPartOf: { "@type": "WebSite", url: SITE_URL },
	}}
>
	<div class="site-shell ui-grid-background min-h-screen isolate relative" id="top">
		<SiteHeader active="terms" />

		<main
			id="main-content"
			tabindex="-1"
			class="relative z-ui-content mx-auto max-w-7xl px-5 pb-24 lg:px-10"
		>
			<section class="py-16 sm:py-[5.5rem]">
				<p class="mb-6 font-ui-mono text-ui-sm tracking-[0.13em] text-[#82949c]">
					<span class="text-ui-accent">&gt;_</span> LEGAL / TERMS
				</p>
				<h1 class="m-0 font-ui-sans text-[clamp(3rem,7vw,6rem)] leading-[0.9] font-extrabold tracking-[-0.08em] text-ui-fg">
					Terms &amp;<br /><em class="text-ui-accent not-italic">conditions.</em>
				</h1>
				<p class="mt-7 max-w-[35rem] text-ui-md leading-[1.9] text-ui-muted">
					Last updated {updated}. These terms govern the portfolio, engineering
					blog, and documentation published by {SITE_AUTHOR}.
				</p>
			</section>
			<TermsContent email={SITE_EMAIL} />
		</main>
		<SiteFooter
			links={[
				{ href: "/blogs/terms/", label: "TERMS" },
				{ href: "/blogs/llms.txt", label: "LLMS.TXT" },
				{ href: "https://sakshampy.in", label: "PORTFOLIO ↗", external: true },
			]}
		/>
	</div>
</Layout>
