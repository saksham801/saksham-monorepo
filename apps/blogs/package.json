{
	"name": "blogs",
	"type": "module",
	"version": "0.0.1",
	"engines": {
		"bun": ">=1.4.0"

	},
	"scripts": {
		"dev": "astro dev",
		"build": "astro build && bun ../../scripts/copy-mounted-headers.mjs blogs",
		"preview": "bun run build && astro preview",
		"lint": "eslint .",
		"typecheck": "astro check",
		"check": "astro check",
		"astro": "astro",
		"generate-types": "cf workers types",
		"deploy": "wrangler deploy --config dist/client/blogs/wrangler.json",
		"cf-typegen": "cf workers types"
	},
	"dependencies": {
		"@saksham/ui": "workspace:*",
		"@astrojs/cloudflare": "^14.3.2",
		"@astrojs/mdx": "^8.0.1",
		"@astrojs/rss": "^4.0.19",
		"astro": "^7.3.3",
		"sharp": "^0.35.0"
	},
	"allowScripts": {
		"esbuild": true
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.10",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26.6.2",
		"cf": "^1.0.0-beta.7",
		"tailwindcss": "^4.3.3",
		"wrangler": "^4.135.0"
	}
}
