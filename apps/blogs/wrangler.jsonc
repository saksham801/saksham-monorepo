{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-09-18",
	"compatibility_flags": [
		"global_fetch_strictly_public"
	],
	"name": "blogs",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true,
		"traces": {
			"enabled": true
		}
	},
	"routes": [
		{
			"pattern": "demo2.sakshampy.in",
			"zone_name": "sakshampy.in",
			"custom_domain": true,
			"enabled": true,
			"previews_enabled": false
		},
		{
			"pattern": "blogs.sakshampy.in",
			"zone_name": "sakshampy.in",
			"custom_domain": true,
			"enabled": true,
			"previews_enabled": false
		}
	],
	"workers_dev": false,
	"preview_urls": false
}