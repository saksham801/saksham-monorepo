{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"printWidth": 100,
	"tabWidth": 4,
	"useTabs": true,
	"semi": true,
	"singleQuote": false,
	"trailingComma": "all",
	"astro": true,
	"ignorePatterns": [
		"**/node_modules/**",
		"**/dist/**",
		"**/.astro/**",
		"**/.cloudflare/**",
		"**/.wrangler/**",
		"**/worker-configuration.d.ts",
		"packages/ui/src/components/ErrorPage.astro"
	]
}
